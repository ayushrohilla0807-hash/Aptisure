{
  "name": "aptisure-chat-server",
  "version": "1.0.0",
  "description": "Academic MERN Real-Time Chat Application Backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node -e 'import(\"./config/db.js\").then(d => d.connectDB()).then(() => import(\"./seedData.js\")).then(s => s.seedDatabase()).then(() => process.exit(0))'"
  },
  "keywords": ["chat", "mern", "socket.io", "express", "mongodb"],
  "author": "Aptisure",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9"
  }
}
